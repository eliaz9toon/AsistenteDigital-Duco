# Copia este archivo como .env y configura la conexión a tu Oracle local.
ORACLE_USER=DUCO_APP
ORACLE_PASSWORD=Cambia_Esta_Clave_123
# Oracle XE: localhost:1521/XEPDB1 | Oracle Free: localhost:1521/FREEPDB1
ORACLE_DSN=localhost:1521/XEPDB1
ADMIN_PORT=8765
# Origen de VS Code Live Server (ajusta el puerto si el servidor eligió otro).
DUCO_ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
